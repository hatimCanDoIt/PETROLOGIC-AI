# =========================================
# PETROLOGIC AI — root environment template
# =========================================
# Copy this file to server/.env (only the SERVER-side variables) and to
# client/.env (only the VITE_* variables). Never commit real .env files.

# ---------- Server (FastAPI) ----------
DATABASE_URL=postgresql+asyncpg://petrologic:petrologic@localhost:5432/petrologic

JWT_SECRET=change-me-please-this-must-be-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080            # 7 days

# Google OAuth (optional — endpoints return 503 until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Anthropic / Claude (optional — if unset, AI interpretation returns a graceful
# "unavailable" payload but the rest of the report still works)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_MB=50

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Client (Vite) ----------
VITE_API_URL=http://localhost:8000
